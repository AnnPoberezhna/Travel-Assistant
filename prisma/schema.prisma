// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement()) 
  email     String   @unique 
  username  String   @unique 
  password  String   
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt
  role      Role     @default(USER)
  favoriteRoutes FavoriteRoutes[]
}

enum Role {
  USER
  ADMIN
}

enum TransportType {
  RAIL
  BUS
  TRAM
  OTHER
}

model Przystanek {
  id          Int     @id @default(autoincrement()) @map("przystanek_id")
  nazwa       String
  latitude    Float?  
  longitude   Float?
  adres       String?
  trasy       Trasa[]
  favoriteRoutes_start FavoriteRoutes[] @relation("PrzystanekStart")
  favoriteRoutes_koniec FavoriteRoutes[] @relation("PrzystanekKoniec")

  @@map("Przystanek")
}

model Przewoznik {
  id          Int      @id @default(autoincrement()) @map("przewoznik_id")
  nazwa       String
  typ         TransportType
  kraj        String?
  kontakt     String?
  polaczenia  Polaczenie[]

  @@map("Przewoznik")
}

model Polaczenie {
  id            Int       @id @default(autoincrement()) @map("polaczenie_id")
  przewoznikId  Int
  nazwa         String?
  typ           TransportType
  przewoznik    Przewoznik @relation(fields: [przewoznikId], references: [id], onDelete: Cascade)
  trasy         Trasa[]

  @@unique([przewoznikId, nazwa])
  @@map("Polaczenie")
}

model Trasa {
  id           Int      @id @default(autoincrement()) @map("ppr_id")
  polaczenieId Int
  przystanekId Int
  kolejnosc    Int
  przyjazdDt   DateTime @map("przyjazd_dt")

  polaczenie   Polaczenie @relation(fields: [polaczenieId], references: [id], onDelete: Cascade)
  przystanek   Przystanek @relation(fields: [przystanekId], references: [id], onDelete: Cascade)

  @@unique([polaczenieId, kolejnosc])
  @@index([przystanekId])
  @@index([polaczenieId])
  @@map("Trasa")
}

model SearchHistory {
  id           Int       @id @default(autoincrement())
  userId       Int?      // optional: anonymous searches allowed
  query        String
  fromText     String?
  toText       String?
  resultsCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("SearchHistory")
}

model FavoriteRoutes {
  id                    Int        @id @default(autoincrement()) @map("ulubiona_trasa_id")
  uzytkownikId          Int        @map("uzytkownik_id")
  przystanekStartId     Int        @map("przystanek_start_id")
  przystanekKoniecId    Int        @map("przystanek_koniec_id")
  createdAt             DateTime   @default(now())

  uzytkownik            User       @relation(fields: [uzytkownikId], references: [id], onDelete: Cascade)
  przystanekStart       Przystanek @relation("PrzystanekStart", fields: [przystanekStartId], references: [id], onDelete: Cascade)
  przystanekKoniec      Przystanek @relation("PrzystanekKoniec", fields: [przystanekKoniecId], references: [id], onDelete: Cascade)

  @@unique([uzytkownikId, przystanekStartId, przystanekKoniecId])
  @@index([uzytkownikId])
  @@map("UlubioneTrasy")
}


