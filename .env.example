# Copy this file to .env and fill in the values.
# The .env file is in .gitignore – it won't be pushed to GitHub.

# PostgreSQL database
DATABASE_URL="postgresql://username:password@localhost:5432/travel_assistant"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"
# Generate one e.g. with: openssl rand -base64 32

# City of Warsaw API (vehicle positions, stops, timetables)
# You get the key after registering at https://api.um.warszawa.pl/
WARSAW_API_KEY=""
