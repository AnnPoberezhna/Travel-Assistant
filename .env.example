# Skopiuj ten plik jako .env i uzupełnij wartości.
# Plik .env jest w .gitignore – nie trafi na GitHuba.

# Baza danych PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/travel_assistant"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"
# Wygeneruj np.: openssl rand -base64 32

# API Miasta Stołecznego Warszawy (pozycje pojazdów, przystanki, rozkłady)
# Klucz dostaniesz po rejestracji na https://api.um.warszawa.pl/
WARSAW_API_KEY=""
